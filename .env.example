# Copy to .env and fill in. Never commit .env.

# ---- LLM (natural-language understanding + answer writing) ----
# gemini | openai | anthropic | offline
#   gemini    -> free API key from https://aistudio.google.com/apikey
#   openai    -> also works for any OpenAI-compatible API (Groq, Together, Ollama) via LLM_BASE_URL
#   offline   -> no LLM; deterministic fallbacks only (useful for tests)
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional. Defaults: gemini-3.8-flash | gpt-4o-mini | claude-haiku-5-5
LLM_MODEL=gemini-3.5-flash-lite
# Optional, e.g. https://api.groq.com/openai/v1  or  http://localhost:11434/v1 (Ollama)
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# ---- App ----
# Used to build assistant URLs and embed code. Set to your public URL when deployed.
PUBLIC_BASE_URL=http://localhost:8000
DATA_DIR=./data
SESSION_TTL_HOURS=24

# ---- Knowledge-base limits (assignment defaults) ----
MAX_DOCS_PER_ORG=10
MAX_PAGES_PER_PDF=20
MAX_PDF_MB=10

# ---- Retrieval / decisions ----
CHUNK_SIZE_WORDS=180
CHUNK_OVERLAP_WORDS=40
TOP_K=5
RELEVANCE_THRESHOLD=0.35
ASK_RATE_LIMIT_PER_MINUTE=30
